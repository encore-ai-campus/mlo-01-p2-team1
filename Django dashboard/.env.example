# Local Django dashboard
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# sample: repository sample metrics / live: real repository queries after schema mapping
DASHBOARD_DATA_MODE=sample

# Single MySQL accepted-data connection
MYSQL_NAME=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# MongoDB rejected-data connection
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=
MONGO_STANDARDIZATION_REJECTED_COLLECTION=standardization_rejected
MONGO_NORMALIZATION_REJECTED_COLLECTION=normalization_rejected
