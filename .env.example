# Bronze Relay source. The API key is intentionally absent: it is fetched
# from BRONZE_API_KEY_ENDPOINT for each run and must never be persisted.
BRONZE_API_BASE_URL=http://192.168.0.51:8000
BRONZE_API_KEY_ENDPOINT=/public/v1/key
BRONZE_API_META_ENDPOINT=/api/v1/meta
BRONZE_API_RECORDS_ENDPOINT=/api/v1/records
BRONZE_SOURCE_NAME=biz_legacy_integrated

# Shared MongoDB Bronze database.
MONGODB_URI=mongodb://192.168.0.33:27017/legacy_bronze
MONGODB_DATABASE=legacy_bronze
MONGODB_RECORDS_COLLECTION=legacy_records
MONGODB_MANIFEST_COLLECTION=crawl_manifests
MONGODB_RUNS_COLLECTION=crawler_runs
MONGODB_STAGING_PREFIX=legacy_records_staging_

# Request and scheduling policy.
CRAWLER_USER_AGENT=legacy-crawler/1.0
CRAWLER_REQUEST_TIMEOUT_SECONDS=15
CRAWLER_PAGE_LIMIT=1000
CRAWLER_MAX_RETRIES=3
CRAWLER_BACKOFF_BASE_SECONDS=2
CRAWLER_BACKOFF_MAX_SECONDS=30
CRAWLER_JITTER_MAX_SECONDS=1
CRAWLER_SAFETY_DELAY_SECONDS=5

# WSL paths to the shared Windows project volume.
DATA_ROOT=/mnt/c/MLOps/project/2nd/data
BACKUP_ROOT=/mnt/c/MLOps/project/2nd/backup
LOG_ROOT=/mnt/c/MLOps/project/2nd/logs
STATE_ROOT=/mnt/c/MLOps/project/2nd/state
